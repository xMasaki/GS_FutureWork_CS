<Window x:Class="GS1_Future_Work.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GS1_Future_Work"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock Text="WorkFuture - Login / Cadastro" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
        
        <Label Content="Usuário:" HorizontalAlignment="Center" Margin="-107,99,0,0" VerticalAlignment="Top" Width="60"/>
        <TextBox x:Name="TxtUsuario" HorizontalAlignment="Center" Margin="78,103,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        
        <Label Content="Senha:" HorizontalAlignment="Center" Margin="-107,147,0,0" VerticalAlignment="Top" Width="60"/>
        <TextBox x:Name="TxtSenha" HorizontalAlignment="Center" Margin="78,151,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        
        <Label Content="Tipo:" HorizontalAlignment="Center" Margin="-107,197,0,0" VerticalAlignment="Top" Width="60"/>
        <ComboBox x:Name="ComboTipo" Width="120" HorizontalAlignment="Center" Margin="78,201,0,0" VerticalAlignment="Top" SelectionChanged="ComboBox_SelectionChanged" >
            <ComboBoxItem>Admin</ComboBoxItem>
            <ComboBoxItem>Colaborador</ComboBoxItem>
        </ComboBox>
        
        <Button Content="Entrar" HorizontalAlignment="Center" Margin="200,257,0,0" VerticalAlignment="Top" Height="50" Width="147" Click="Button_Entrar"/>
        
        <Button Content="Cadastrar" HorizontalAlignment="Center" Margin="-200,257,0,0" VerticalAlignment="Top" Height="50" Width="147" Click="Button_Cadastrar"/>
    </Grid>
</Window>
