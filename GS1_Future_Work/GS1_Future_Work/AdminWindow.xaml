<Window x:Class="GS1_Future_Work.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GS1_Future_Work"
        mc:Ignorable="d"
        Title="AdminWindow" Height="450" Width="800">
    <Grid>
        <TextBlock Text="WorkFuture - Admin" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />

        <Label Content="Curso:" HorizontalAlignment="Center" Margin="-107,99,0,0" VerticalAlignment="Top" Width="60"/>
        <TextBox x:Name="TxtCurso" HorizontalAlignment="Center" Margin="78,103,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>

        <Label Content="Professor:" HorizontalAlignment="Center" Margin="-107,147,0,0" VerticalAlignment="Top" Width="60"/>
        <TextBox x:Name="TxtProfessor" HorizontalAlignment="Center" Margin="78,151,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>

        <Label Content="Duração:" HorizontalAlignment="Center" Margin="-107,197,0,0" VerticalAlignment="Top" Width="60"/>
        <TextBox x:Name="TxtDuracao" HorizontalAlignment="Center" Margin="78,201,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        
        <Button Content="Adicionar" HorizontalAlignment="Center" Margin="200,257,0,0" VerticalAlignment="Top" Height="50" Width="147" Click="Button_Adicionar"/>

        <Button Content="Sair" HorizontalAlignment="Center" Margin="-200,257,0,0" VerticalAlignment="Top" Height="50" Width="147" Click="Button_Sair"/>
    </Grid>
</Window>
